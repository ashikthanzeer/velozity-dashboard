# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String
# Matches docker-compose.yml and default embedded runner
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/velozity_db?schema=public

# Security Secrets
JWT_SECRET=velozity_jwt_access_secret_super_secure_key_2026_prod
REFRESH_SECRET=velozity_jwt_refresh_secret_super_secure_key_2026_prod
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Client Application URL for CORS and WebSocket handshake
CLIENT_URL=http://localhost:5173
